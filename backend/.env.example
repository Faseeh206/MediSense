# Copy to backend/.env. Keep real secrets out of frontend variables and source control.
ANALYSIS_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=90
OPENROUTER_MAX_OUTPUT_TOKENS=8192
# Free NVIDIA endpoints: fictional documents only; no personal/confidential data.
# Gemini is retained only for an explicit ANALYSIS_PROVIDER=gemini configuration.
GEMINI_API_KEY=
# Choose a model available to your Google AI Studio project.
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_OUTPUT_TOKENS=8192

# Explicit local mode: no PostgreSQL connection is attempted.
DATABASE_BACKEND=sqlite
DATABASE_URL=
# SQLITE_PATH defaults to backend/medisense.db.
ALLOW_SQLITE_FALLBACK=False

# Optional PostgreSQL setup (not required for local evaluation).
# DATABASE_BACKEND=postgres
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_local_password
# POSTGRES_DATABASE=medisense_db

# For separate frontend hosting, list exact HTTPS origin(s), comma separated.
CORS_ORIGINS=
ALLOW_LOCAL_ORIGINS=True

# Administrative config/sync endpoints stay disabled while blank.
# If used, supply a private random token of at least 32 characters server-side.
ADMIN_API_TOKEN=
ANALYSES_PER_HOUR=20
MAX_PDF_PAGES=30
# Vercel can analyze fictional samples without a database; results are not saved.
# In this mode the local limiter is per instance, not shared across instances.
# OpenRouter's account quota still applies. Set false to require a database.
ALLOW_STATELESS_ANALYSIS=True

# Vercel deployment (set these in the backend project's environment, not here):
# DATABASE_BACKEND=postgres
# DATABASE_URL=your_hosted_postgres_connection_string_with_ssl
# ALLOW_SQLITE_FALLBACK=False
# CORS_ORIGINS=https://your-frontend-domain
# ALLOW_LOCAL_ORIGINS=False
# Vercel defaults to 4194304 bytes (4 MB), leaving room for multipart overhead.
# MAX_UPLOAD_BYTES=4194304
