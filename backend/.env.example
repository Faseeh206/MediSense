# Copy to backend/.env. Keep real secrets out of frontend variables and source control.
GEMINI_API_KEY=your_gemini_api_key_here
# Choose a model available to your Google AI Studio project.
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_OUTPUT_TOKENS=8192

# Explicit local mode: no PostgreSQL connection is attempted.
DATABASE_BACKEND=sqlite
DATABASE_URL=
# SQLITE_PATH defaults to backend/medisense.db.
ALLOW_SQLITE_FALLBACK=False

# Optional PostgreSQL setup (not required for local evaluation).
# DATABASE_BACKEND=postgres
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_local_password
# POSTGRES_DATABASE=medisense_db

# For separate frontend hosting, list exact HTTPS origin(s), comma separated.
CORS_ORIGINS=
ALLOW_LOCAL_ORIGINS=True

# Administrative config/sync endpoints stay disabled while blank.
# If used, supply a private random token of at least 32 characters server-side.
ADMIN_API_TOKEN=
ANALYSES_PER_HOUR=20
MAX_PDF_PAGES=30
